{
  "expo": {
    "name": "transporte-publico",
    "slug": "transporte-publico",
    "version": "1.0.0",
    "scheme": "transporte-publico",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Permite acceder a la cámara para escanear el código QR de las paradas."
        }
      ]
    ]
  }
}
